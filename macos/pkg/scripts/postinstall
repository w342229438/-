#!/bin/zsh
set -euo pipefail

APP_DIR="/Applications/Codex Pet Usage Overlay"
MARKER_BEGIN="-- BEGIN CODEX PET USAGE OVERLAY"
MARKER_END="-- END CODEX PET USAGE OVERLAY"
MODULE_NAME="codex-pet-usage-overlay"
SCRIPT_PATH="$0"

log() {
  print "CodexPetUsageOverlay installer: $*"
}

extract_payload() {
  local name="$1"
  local begin="__CODEX_PET_USAGE_${name}_START__"
  local end="__CODEX_PET_USAGE_${name}_END__"
  awk -v begin="$begin" -v end="$end" '
    $0 == begin { copying = 1; next }
    $0 == end { exit }
    copying { print }
  ' "$SCRIPT_PATH" | /usr/bin/base64 -D
}

install_hammerspoon_if_needed() {
  local target="/Applications/Hammerspoon.app"
  local temporary_directory

  if [[ -d "$target" ]]; then
    log "Keeping existing Hammerspoon installation."
    return
  fi

  temporary_directory="$(mktemp -d /private/tmp/codex-pet-hammerspoon.XXXXXX)"
  extract_payload "HAMMERSPOON_ZIP" > "$temporary_directory/Hammerspoon.zip"
  /usr/bin/unzip -q "$temporary_directory/Hammerspoon.zip" -d "$temporary_directory/unpacked"

  if [[ ! -d "$temporary_directory/unpacked/Hammerspoon.app" ]]; then
    log "Bundled Hammerspoon app is missing."
    rm -rf "$temporary_directory"
    exit 1
  fi

  if ! /usr/bin/codesign --verify --deep --strict "$temporary_directory/unpacked/Hammerspoon.app"; then
    log "Bundled Hammerspoon signature verification failed."
    rm -rf "$temporary_directory"
    exit 1
  fi

  /usr/bin/ditto "$temporary_directory/unpacked/Hammerspoon.app" "$target"
  rm -rf "$temporary_directory"
  log "Installed bundled Hammerspoon to $target."
}

console_user="$(stat -f '%Su' /dev/console)"
if [[ -z "$console_user" || "$console_user" == "root" || "$console_user" == "loginwindow" ]]; then
  log "No logged-in user found. Open the installer again after signing in."
  exit 0
fi

user_home="$(dscl . -read "/Users/$console_user" NFSHomeDirectory | awk '{print $2}')"
user_uid="$(id -u "$console_user")"
user_group="$(id -gn "$console_user")"
config_dir="$user_home/.hammerspoon"
target="$config_dir/codex-pet-usage-overlay.lua"
init_file="$config_dir/init.lua"
legacy_dir="$user_home/Library/Application Support/CodexPetUsageOverlay"
legacy_agent="$user_home/Library/LaunchAgents/dev.jimmyasksai.codex-pet-usage-overlay.plist"

# Versions before 2.0 shipped a separate Swift overlay. If it is still alive it
# draws a second ring, so upgrades retire only those known legacy components.
if [[ -f "$legacy_agent" ]]; then
  launchctl asuser "$user_uid" launchctl bootout "gui/$user_uid" "$legacy_agent" >/dev/null 2>&1 || true
  rm -f "$legacy_agent"
fi
pkill -u "$user_uid" -x codex-pet-usage-overlay-mac >/dev/null 2>&1 || true
pkill -u "$user_uid" -x CodexPetUsageOverlay >/dev/null 2>&1 || true
rm -rf "$legacy_dir/CodexPetUsageOverlay.app" "$legacy_dir/CodexPetUsageOverlay2.app"
rm -f "$legacy_dir/codex-pet-usage-overlay-mac" "$legacy_dir/overlay.pid"

install_hammerspoon_if_needed

install -d -m 755 -o "$console_user" -g "$user_group" "$config_dir"
extract_payload "OVERLAY" > "$target"
chown "$console_user:$user_group" "$target"
chmod 644 "$target"

install -d -m 755 "$APP_DIR"
extract_payload "UNINSTALL" > "$APP_DIR/Uninstall.command"
extract_payload "README" > "$APP_DIR/README.txt"
chmod 755 "$APP_DIR/Uninstall.command"
chmod 644 "$APP_DIR/README.txt"

if [[ ! -e "$init_file" ]]; then
  install -m 644 -o "$console_user" -g "$user_group" /dev/null "$init_file"
fi

if grep -Fq -- "$MARKER_BEGIN" "$init_file"; then
  temporary_file="$(mktemp "$config_dir/init.lua.XXXXXX")"
  awk -v begin="$MARKER_BEGIN" -v end="$MARKER_END" '
    $0 == begin { skipping = 1; next }
    $0 == end { skipping = 0; next }
    !skipping { print }
  ' "$init_file" > "$temporary_file"
  mv "$temporary_file" "$init_file"
fi

if grep -Fq -- "$MODULE_NAME" "$init_file"; then
  log "Using existing Hammerspoon load configuration."
else
  {
    print ""
    print -r -- "$MARKER_BEGIN"
    print 'local ok, err = pcall(require, "codex-pet-usage-overlay")'
    print "if not ok then"
    print '  hs.printf("Codex pet usage overlay failed: %s", tostring(err))'
    print "end"
    print -r -- "$MARKER_END"
  } >> "$init_file"
fi

chown "$console_user:$user_group" "$init_file"
chmod 644 "$init_file"

if [[ -d "/Applications/Hammerspoon.app" ]]; then
  launchctl asuser "$user_uid" /usr/bin/open -a Hammerspoon || true
  log "Installed overlay for $console_user and opened Hammerspoon."
else
  log "Installed overlay for $console_user. Install Hammerspoon, then open it once to load the overlay."
fi

exit 0
